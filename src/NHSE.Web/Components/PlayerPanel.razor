@inject SaveSession Session

<section class="card profile">
    @if (photo is not null)
    {
        <img class="passport" src="@photo" alt="@L.T("Passfoto", "Passport photo")" />
    }
    <div class="profile-fields">
        <label>
            <span>@L.T("Name", "Name")</span>
            <input maxlength="10" value="@name" @onchange="e => Rename((string?)e.Value)" />
        </label>
        <label>
            <span>@L.T("Insel", "Island")</span>
            <input maxlength="10" value="@town" @onchange="e => RenameTown((string?)e.Value)" />
        </label>
        <p class="hint">@L.T("Höchstens 10 Zeichen. Der Name wird überall im Spielstand mitgeändert, auch bei den Bewohnern.",
                             "Up to 10 characters. The name is changed everywhere in the save, villagers included.")</p>
    </div>
</section>

<section class="card">
    <header class="card-head"><h3>@L.T("Geld und Meilen", "Money and miles")</h3></header>
    <div class="stats">
        <MoneyField Label="@L.T("Sterni in der Tasche", "Bells in pocket")" Icon="menuicon/MoneyBag039.png"
                    Value="@Personal.Wallet.Value" Max="99999" Steps="@(new uint[] { 10000 })"
                    ValueChanged="v => Set(v, (p, x) => p.Wallet = p.Wallet with { Value = x })" />
        <MoneyField Label="@L.T("Sterni auf der Bank", "Bells in the bank")" Icon="menuicon/MoneyBag069.png"
                    Value="@Personal.Bank.Value" Max="999999999" Steps="@(new uint[] { 100000, 1000000 })"
                    ValueChanged="v => Set(v, (p, x) => p.Bank = p.Bank with { Value = x })" />
        <MoneyField Label="@L.T("Meilen", "Nook Miles")" Icon="menuicon/PlaneTicket.png"
                    Value="@Personal.NookMiles.Value" Max="9999999" Steps="@(new uint[] { 10000, 100000 })"
                    ValueChanged="v => Set(v, (p, x) => p.NookMiles = p.NookMiles with { Value = x })" />
        <MoneyField Label="@L.T("Meilen insgesamt", "Nook Miles in total")" Icon="menuicon/BellExchangeTicket.png"
                    Value="@Personal.TotalNookMiles.Value" Max="99999999" Steps="@(new uint[] { 100000 })"
                    ValueChanged="v => Set(v, (p, x) => p.TotalNookMiles = p.TotalNookMiles with { Value = x })" />
        @if (Personal.Data30 is { IsInitialized30: true } extra)
        {
            <MoneyField Label="@L.T("Hotel-Tickets", "Hotel tickets")" Icon="menuicon/RollanTicket.png"
                        Value="@extra.HotelTickets.Value" Max="99999" Steps="@(new uint[] { 100 })"
                        ValueChanged="v => { extra.HotelTickets = extra.HotelTickets with { Value = v }; Session.MarkDirty(); }" />
        }
        @if (Player.WhereAreN is { } where)
        {
            <MoneyField Label="Poki" Icon="menuicon/Coin.png"
                        Value="@where.Poki.Value" Max="99999" Steps="@(new uint[] { 1000 })"
                        ValueChanged="v => { where.Poki = where.Poki with { Value = v }; Session.MarkDirty(); }" />
        }
    </div>
</section>

<section class="card">
    <header class="card-head"><h3>@L.T("Profil", "Profile")</h3></header>
    <div class="profile-fields">
        <label>
            <span>@L.T("Geburtstag (Tag und Monat)", "Birthday (day and month)")</span>
            <span class="date-pair">
                <input type="number" min="1" max="31" value="@birthday.Day" @onchange="e => SetBirthday(e.Value, null)" />
                <input type="number" min="1" max="12" value="@birthday.Month" @onchange="e => SetBirthday(null, e.Value)" />
            </span>
        </label>
        <label>
            <span>@L.T("Inselfrucht im Pass", "Native fruit in the passport")</span>
            <select value="@Personal.ProfileFruit" @onchange="SetFruit">
                @foreach (var fruit in GameLists.Fruits.ToArray())
                {
                    <option value="@fruit">@GameInfo.Strings.itemlist[fruit]</option>
                }
            </select>
        </label>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public Player Player { get; set; } = null!;

    private Personal Personal => Player.Personal;
    private string name = string.Empty;
    private string town = string.Empty;
    private string? photo;
    private Player? loadedFor;

    protected override void OnParametersSet()
    {
        name = Personal.PlayerName;
        town = Personal.TownName;
        if (!ReferenceEquals(loadedFor, Player))
        {
            loadedFor = Player;
            var jpeg = Personal.GetPhotoData();
            photo = jpeg.Length > 0 ? "data:image/jpeg;base64," + Convert.ToBase64String(jpeg) : null;
        }
    }

    private GSaveDateMD birthday => Personal.Birthday;

    // like NHSE's misc player editor: the passport shows the same date
    private void SetBirthday(object? day, object? month)
    {
        var date = Personal.Birthday;
        if (byte.TryParse(day?.ToString(), out var d) && d is >= 1 and <= 31)
            date.Day = d;
        if (byte.TryParse(month?.ToString(), out var m) && m is >= 1 and <= 12)
            date.Month = m;
        Personal.Birthday = date;
        Personal.ProfileBirthday = date;
        Session.MarkDirty();
    }

    private void SetFruit(ChangeEventArgs e)
    {
        if (!ushort.TryParse(e.Value?.ToString(), out var fruit))
            return;
        Personal.ProfileFruit = fruit;
        Session.MarkDirty();
    }

    private void Set(uint value, Action<Personal, uint> apply)
    {
        apply(Personal, value);
        Session.MarkDirty();
    }

    // Like NHSE: the name is part of an identity block that also appears in the island and
    // the villagers' memories, so every copy of the block is replaced.
    private void Rename(string? value)
    {
        value = (value ?? string.Empty).Trim();
        if (value.Length == 0 || value == Personal.PlayerName || Session.Save is null)
            return;
        var original = Personal.GetPlayerIdentity().ToArray();
        Personal.PlayerName = value;
        Session.Save.ChangeIdentity(original, Personal.GetPlayerIdentity());
        name = value;
        Session.MarkDirty();
    }

    private void RenameTown(string? value)
    {
        value = (value ?? string.Empty).Trim();
        if (value.Length == 0 || value == Personal.TownName || Session.Save is null)
            return;
        var original = Personal.GetTownIdentity().ToArray();
        Personal.TownName = value;
        Session.Save.ChangeIdentity(original, Personal.GetTownIdentity());
        town = value;
        Session.MarkDirty();
    }
}
