@inject SaveSession Session
@inject ItemCatalog Catalog

<section class="card">
    <header class="card-head">
        <h3 class="with-icon"><img src="menuicon/Porch.png" alt="" />@L.T($"Haus von {Player.Personal.PlayerName}", $"{Player.Personal.PlayerName}'s house")</h3>
        <span class="pill">@L.T($"Ausbaustufe {house?.HouseLevel}", $"Upgrade level {house?.HouseLevel}")</span>
    </header>

    <div class="map-toolbar">
        <div class="segmented">
            @for (int i = 0; i < Rooms; i++)
            {
                var r = i;
                <button class="@(room == r ? "active" : "")" @onclick="() => SetRoom(r)">@L.T($"Raum {r + 1}", $"Room {r + 1}")</button>
            }
        </div>
        <div class="segmented wrap">
            @foreach (var s in Enum.GetValues<RoomLayerSurface>())
            {
                var surface = s;
                <button class="@(layer == surface ? "active" : "")" @onclick="() => SetLayer(surface)">@SurfaceName(surface)</button>
            }
        </div>
    </div>

    <div class="map-bar">
        @if (selected is { } sel && Layer.GetTile(sel.X, sel.Y) is { IsNone: false } tile)
        {
            <ItemImage Src="@Catalog.PictureOf(tile)" Alt="@GameInfo.Strings.GetItemName(tile)" />
            <div class="brush-text">
                <strong>@GameInfo.Strings.GetItemName(tile)</strong>
                <span class="hint">@L.T($"Feld {sel.X}, {sel.Y}", $"Tile {sel.X}, {sel.Y}")</span>
            </div>
            <button class="small" @onclick="Rotate">&#x21BB; @L.T("Drehen", "Rotate")</button>
            <button class="small" @onclick="() => picking = true">@L.T("Ersetzen", "Replace")</button>
            <button class="small danger" @onclick="Remove">@L.T("Entfernen", "Remove")</button>
        }
        else
        {
            <span class="hint">@L.T("Tippe auf ein freies Feld, um dort etwas hinzustellen, oder auf ein Möbelstück, um es zu ändern.",
                                    "Tap a free tile to put something there, or a piece of furniture to change it.")</span>
        }
    </div>

    <div class="room-grid">
        @for (int y = 0; y < Size; y++)
        {
            for (int x = 0; x < Size; x++)
            {
                var (cx, cy) = (x, y);
                <button class="room-cell" style="grid-area: @(cy + 1) / @(cx + 1)" aria-label="@L.T($"Feld {cx}, {cy}", $"Tile {cx}, {cy}")" @onclick="() => Tap(cx, cy)"></button>
            }
        }
        @foreach (var (x, y, w, h, item) in Roots())
        {
            var (rx, ry) = (x, y);
            <button class="room-item @(selected is { } s && s.X == rx && s.Y == ry ? "selected" : "")"
                    style="grid-area: @(ry + 1) / @(rx + 1) / span @h / span @w" title="@GameInfo.Strings.GetItemName(item)"
                    @onclick="() => Select(rx, ry)">
                <ItemImage Src="@Catalog.PictureOf(item)" Alt="@GameInfo.Strings.GetItemName(item)" />
            </button>
        }
    </div>
    @if (message is not null)
    {
        <p class="hint center">@message</p>
    }
    <p class="hint">@L.T("Ein Raum ist 20 x 20 Felder groß, kleine Möbel belegen 2 x 2. Räume, die das Haus noch nicht hat, erscheinen erst nach dem Ausbau im Spiel.",
                         "A room is 20 x 20 tiles, small furniture takes 2 x 2. Rooms the house does not have yet only show up in the game after the upgrade.")</p>

    @if (manager?.Room is PlayerRoom1 surfaces)
    {
        <h4>@L.T($"Tapete und Boden in Raum {room + 1}", $"Wallpaper and flooring in room {room + 1}")</h4>
        <RoomSurfaces Value="@surfaces.RoomFloorWall" ValueChanged="SetSurfaces" />
    }

    <div class="buttons">
        <button @onclick="SaveRoom">@L.T($"Raum {room + 1} sichern (.{manager?.Room.Extension})", $"Save room {room + 1} (.{manager?.Room.Extension})")</button>
        <label class="button">
            @L.T($"Raum {room + 1} laden", $"Load room {room + 1}")
            <InputFile accept=".nhpr,.nhpr2" OnChange="LoadRoom" />
        </label>
    </div>
</section>

@if (house is not null)
{
    <section class="card">
        <header class="card-head">
            <h3 class="with-icon"><img src="menuicon/Porch.png" alt="" />@L.T("Das Haus von außen", "The house from outside")</h3>
        </header>
        <HouseExterior House="house" ForPlayer="true" Changed="StoreHouse" />
        <div class="buttons">
            <button @onclick="SaveHouse">@L.T($"Ganzes Haus sichern (.{house.Extension})", $"Save the whole house (.{house.Extension})")</button>
            <label class="button">
                @L.T("Ganzes Haus laden", "Load a whole house")
                <InputFile accept=".nhph,.nhph2" OnChange="LoadHouse" />
            </label>
            <button @onclick="() => houseFlags = house.EventFlags.ToArray()">@L.T("Haus-Flags", "House flags")</button>
        </div>
        @if (fileMessage is not null)
        {
            <p class="hint">@fileMessage</p>
        }
        <p class="hint">@L.T("Ein Haus aus einer Datei bringt alle Räume, die Einrichtung und das Äußere mit, wie in NHSE.",
                             "A house from a file brings all rooms, the furniture and the outside along, like NHSE.")</p>
    </section>
}

@if (houseFlags is { } hf)
{
    <FlagListDialog Title="@L.T("Haus-Flags", "House flags")" Count="@hf.Length" Get="i => hf[i]" Set="(i, v) => hf[i] = (short)v"
                    Describe="FlagNames.House" FileName="EventFlagHouse" Changed="() => { hf.AsSpan().CopyTo(house!.EventFlags); StoreHouse(); }" Closed="() => houseFlags = null" />
}

@if (picking)
{
    <ItemPickerDialog Title="@L.T("Was soll hier stehen?", "What should stand here?")"
                      Current="@(selected is { } s ? Layer.GetTile(s.X, s.Y) : null)"
                      Picked="Picked" Closed="() => picking = false" />
}

@code {
    private readonly record struct Spot(int X, int Y);

    private const int Rooms = 6;
    private const int Size = 20;

    [Parameter, EditorRequired] public Player Player { get; set; } = null!;
    [Parameter] public int Index { get; set; }

    private IPlayerHouse? house;
    private RoomManager? manager;
    private int room;
    private RoomLayerSurface layer;
    private Spot? selected;
    private Spot? target;
    private bool picking;
    private string? message;
    private int loadedFor = -1;

    private string? fileMessage;
    private short[]? houseFlags;

    private MainSave Main => Session.Save!.Main;
    private LayerRoomItem Layer => manager!.Layers[(int)layer];

    private void StoreHouse()
    {
        Main.SetPlayerHouse(house!, Index);
        Session.MarkDirty();
    }

    private void SetSurfaces(GSaveRoomFloorWall value)
    {
        if (manager?.Room is not PlayerRoom1 r)
            return;
        r.RoomFloorWall = value;
        Store();
    }

    private string HouseName => Files.Safe($"{Player.Personal.PlayerName} house");

    private Task SaveHouse() => Files.Save(Session, $"{HouseName}.{house!.Extension}", house.Write());

    private Task SaveRoom()
    {
        manager!.Save();
        return Files.Save(Session, $"Room {room + 1}.{manager.Room.Extension}", manager.Room.Write());
    }

    // like NHSE: older and newer house files are converted to this save's size, the household stays
    private async Task LoadHouse(InputFileChangeEventArgs e)
    {
        var expect = Main.Offsets.PlayerHouseSize;
        var data = await Files.Read(e.File, 4 * 1024 * 1024);
        if (data is null || !PlayerHouseConverter.IsCompatible(data.Length, expect))
        {
            fileMessage = IslandMap.SizeError((int)e.File.Size, expect);
            return;
        }
        data = PlayerHouseConverter.GetCompatible(data, expect);
        if (data.Length != expect)
        {
            fileMessage = IslandMap.SizeError(data.Length, expect);
            return;
        }
        var loaded = Main.Offsets.ReadPlayerHouse(data);
        loaded.NPC1 = house!.NPC1;
        house = loaded;
        StoreHouse();
        SetRoom(room);
        fileMessage = L.T("Haus geladen.", "Loaded the house.");
    }

    private async Task LoadRoom(InputFileChangeEventArgs e)
    {
        var expect = Main.Offsets.PlayerRoomSize;
        var data = await Files.Read(e.File, 1024 * 1024);
        if (data is null || !PlayerRoomConverter.IsCompatible(data.Length, expect))
        {
            message = IslandMap.SizeError((int)e.File.Size, expect);
            return;
        }
        data = PlayerRoomConverter.GetCompatible(data, expect);
        if (data.Length != expect)
        {
            message = IslandMap.SizeError(data.Length, expect);
            return;
        }
        house!.SetRoom(room, Main.Offsets.ReadPlayerRoom(data));
        StoreHouse();
        SetRoom(room);
        message = L.T("Raum geladen.", "Loaded the room.");
    }

    protected override async Task OnParametersSetAsync()
    {
        if (loadedFor != Index)
        {
            loadedFor = Index;
            house = Main.GetPlayerHouse(Index);
            SetRoom(0);
        }
        await Catalog.EnsureLoadedAsync();
    }

    private void SetRoom(int index)
    {
        room = index;
        manager = new RoomManager(house!.GetRoom(room));
        selected = null;
        message = null;
    }

    private void SetLayer(RoomLayerSurface value)
    {
        layer = value;
        selected = null;
        message = null;
    }

    private IEnumerable<(int X, int Y, int W, int H, Item Item)> Roots()
    {
        for (int y = 0; y < Size; y++)
        {
            for (int x = 0; x < Size; x++)
            {
                var tile = Layer.GetTile(x, y);
                if (tile.IsNone || !tile.IsRoot)
                    continue;
                var (w, h) = IslandMap.Footprint(tile);
                yield return (x, y, Math.Min(w, Size - x), Math.Min(h, Size - y), tile);
            }
        }
    }

    private void Tap(int x, int y)
    {
        message = null;
        var tile = Layer.GetTile(x, y);
        if (tile.IsExtension)
        {
            Select(x - tile.ExtensionX, y - tile.ExtensionY);
            return;
        }
        selected = null;
        target = new Spot(x, y);
        picking = true;
    }

    private void Select(int x, int y)
    {
        message = null;
        selected = new Spot(x, y);
        target = selected;
    }

    private void Store()
    {
        manager!.Save();
        house!.SetRoom(room, manager.Room);
        Main.SetPlayerHouse(house, Index);
        Session.MarkDirty();
    }

    private static void Delete(LayerItem layer, Spot spot)
    {
        var tile = layer.GetTile(spot.X, spot.Y);
        if (tile.IsRoot)
            layer.DeleteExtensionTiles(tile, spot.X, spot.Y);
        tile.Delete();
    }

    // Same rules as NHSE's room editor: big items get their extension tiles and nothing is overwritten.
    private bool Place(Item item, Spot spot)
    {
        switch (Layer.IsOccupied(item, spot.X, spot.Y))
        {
            case PlacedItemPermission.OutOfBounds:
                message = L.T("Das passt dort nicht mehr in den Raum.", "That does not fit into the room there.");
                return false;
            case PlacedItemPermission.Collision:
                message = L.T("Dort steht schon etwas.", "Something already stands there.");
                return false;
        }
        Layer.SetExtensionTiles(item, spot.X, spot.Y);
        Layer.GetTile(spot.X, spot.Y).CopyFrom(item);
        return true;
    }

    // replacing and rotating take the old item away first and put it back if the new one does not fit
    private bool Swap(Spot spot, Item item)
    {
        var old = new Item(Layer.GetTile(spot.X, spot.Y).RawValue);
        Delete(Layer, spot);
        if (Place(item, spot))
            return true;
        if (!old.IsNone)
            Place(old, spot);
        return false;
    }

    private void Picked(Item item)
    {
        picking = false;
        if (target is not { } spot)
            return;
        if (Swap(spot, item))
        {
            selected = spot;
            Store();
        }
    }

    private void Rotate()
    {
        if (selected is not { } spot)
            return;
        var item = new Item(Layer.GetTile(spot.X, spot.Y).RawValue);
        item.Rotation = (item.Rotation + 1) & 3;
        if (Swap(spot, item))
            Store();
    }

    private void Remove()
    {
        if (selected is not { } spot)
            return;
        Delete(Layer, spot);
        selected = null;
        Store();
    }

    private static string SurfaceName(RoomLayerSurface surface) => surface switch
    {
        RoomLayerSurface.Floor => L.T("Boden", "Floor"),
        RoomLayerSurface.FloorSupported => L.T("Auf Möbeln", "On furniture"),
        RoomLayerSurface.WallNorth => L.T("Rückwand", "Back wall"),
        RoomLayerSurface.WallWest => L.T("Linke Wand", "Left wall"),
        RoomLayerSurface.WallSouth => L.T("Vorderwand", "Front wall"),
        RoomLayerSurface.WallEast => L.T("Rechte Wand", "Right wall"),
        RoomLayerSurface.Rugs => L.T("Teppiche", "Rugs"),
        _ => L.T("Decke", "Ceiling"),
    };
}
