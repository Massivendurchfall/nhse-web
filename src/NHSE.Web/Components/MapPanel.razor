@implements IAsyncDisposable
@inject SaveSession Session
@inject ItemCatalog Catalog
@inject IJSRuntime JS

<section class="card">
    <header class="card-head">
        <h3>@L.T("Karte", "Map")</h3>
        <div class="segmented">
            <button class="@(layerIndex == 0 ? "active" : "")" @onclick="() => SetLayer(0)">@L.T("Boden", "Ground")</button>
            <button class="@(layerIndex == 1 ? "active" : "")" @onclick="() => SetLayer(1)">@L.T("Auf Möbeln", "On furniture")</button>
        </div>
    </header>

    <div class="map-toolbar">
        <div class="segmented">
            <button class="@(mode == Mode.Look ? "active" : "")" @onclick="() => SetMode(Mode.Look)">@L.T("Ansehen", "Look")</button>
            <button class="@(mode == Mode.Place ? "active" : "")" @onclick="() => SetMode(Mode.Place)">@L.T("Setzen", "Place")</button>
            <button class="@(mode == Mode.Erase ? "active" : "")" @onclick="() => SetMode(Mode.Erase)">@L.T("Entfernen", "Remove")</button>
            <button class="@(mode == Mode.Area ? "active" : "")" @onclick="() => SetMode(Mode.Area)">@L.T("Bereich", "Area")</button>
            <button class="@(mode == Mode.Paths ? "active" : "")" @onclick="() => SetMode(Mode.Paths)">@L.T("Wege", "Paths")</button>
            <button class="@(mode == Mode.Terrain ? "active" : "")" @onclick="() => SetMode(Mode.Terrain)">@L.T("Gelände", "Terrain")</button>
            <button class="@(mode == Mode.Bridges ? "active" : "")" @onclick="() => SetMode(Mode.Bridges)">@L.T("Brücken", "Bridges")</button>
            <button class="@(mode == Mode.Buildings ? "active" : "")" @onclick="() => SetMode(Mode.Buildings)">@L.T("Bauwerke", "Structures")</button>
        </div>
        <div class="segmented">
            <button class="@(across == 16 ? "active" : "")" @onclick="() => Zoom(16)">@L.T("Nah", "Close")</button>
            <button class="@(across == 32 ? "active" : "")" @onclick="() => Zoom(32)">@L.T("Weit", "Wide")</button>
        </div>
        <button class="small" @onclick="Undo" disabled="@(undo.Count == 0)">&#x21B6; @L.T("Rückgängig", "Undo")</button>
    </div>

    @* one bar for the current tool, so the map never moves *@
    <div class="map-bar">
        @switch (mode)
        {
            case Mode.Place:
                @if (brush is null)
                {
                    <span class="hint">@L.T("Was möchtest du setzen?", "What do you want to place?")</span>
                }
                else
                {
                    var (w, h) = IslandMap.Footprint(brush);
                    <ItemImage Src="@Picture(brush)" Alt="@FieldItems.Name(brush)" />
                    <div class="brush-text">
                        <strong>@FieldItems.Name(brush)</strong>
                        <span class="hint">@L.T($"{w} x {h} Felder. Tippen oder mit gedrückter Taste malen.", $"{w} x {h} tiles. Tap, or hold and drag to paint.")</span>
                    </div>
                    @if (brush.IsFieldItem)
                    {
                        <BrushSize Value="@size" ValueChanged="SetSize" />
                    }
                    else
                    {
                        <button class="small" @onclick="Rotate">&#x21BB; @L.T("Drehen", "Rotate")</button>
                    }
                }
                <button class="small @(brush is null ? "primary" : "")" @onclick="() => picking = Picking.Brush">@L.T("Gegenstand", "Item")</button>
                <button class="small @(brush is null ? "primary" : "")" @onclick="() => picking = Picking.NatureBrush">@L.T("Natur", "Nature")</button>
                break;

            case Mode.Erase:
                <span class="hint grow">@L.T("Tippe auf etwas oder fahre mit gedrückter Taste darüber, um es zu entfernen.",
                                             "Tap something, or hold and drag over it, to remove it.")</span>
                <BrushSize Value="@size" ValueChanged="SetSize" />
                break;

            case Mode.Area when area is { } a:
                <div class="brush-text">
                    <strong>@L.T($"Bereich {a.W} x {a.H} Felder", $"Area of {a.W} x {a.H} tiles")</strong>
                    <span class="hint">@L.T("Zieh ein neues Rechteck auf, um den Bereich zu ändern.", "Drag a new rectangle to change the area.")</span>
                </div>
                <button class="small danger" @onclick="ClearArea">@L.T("Leeren", "Clear")</button>
                <button class="small" @onclick="WeedArea">@L.T("Unkraut weg", "Remove weeds")</button>
                <button class="small" @onclick="FillArea" disabled="@(brush is null)"
                        title="@(brush is null ? L.T("Wähle zuerst unter „Setzen“ etwas aus.", "Choose something under \"Place\" first.") : FieldItems.Name(brush))">
                    @L.T("Füllen", "Fill")@(brush is null ? "" : $": {FieldItems.Name(brush)}")
                </button>
                <button class="small" @onclick="() => bulkDrop = true">@L.T("Viele hinlegen", "Drop many")</button>
                <button class="small" @onclick="() => PathArea(pathType)">@L.T("Weg legen", "Lay path"): @RoadShapes.TypeName(pathType)</button>
                <button class="small" @onclick="() => PathArea(null)">@L.T("Wege entfernen", "Remove paths")</button>
                break;

            case Mode.Area:
                <span class="hint">@L.T("Zieh mit gedrückter Taste ein Rechteck auf. Danach kannst du es leeren, mit etwas füllen oder einen Weg legen.",
                                        "Hold and drag a rectangle. Then you can clear it, fill it or lay a path.")</span>
                break;

            case Mode.Paths:
                <div class="path-types">
                    @foreach (var t in RoadShapes.Types)
                    {
                        var type = t;
                        <button class="path-type @(pathType == type && !pathEraser ? "active" : "")" @onclick="() => SetPathType(type)">
                            <span class="swatch" style="background: @RoadShapes.TypeColor(type)"></span>@RoadShapes.TypeName(type)
                        </button>
                    }
                    <button class="path-type @(pathEraser ? "active" : "")" @onclick="() => SetPathType(null)">
                        <span class="swatch eraser"></span>@L.T("Weg entfernen", "Remove path")
                    </button>
                </div>
                <BrushSize Value="@size" ValueChanged="SetSize" />
                break;

            case Mode.Terrain:
                <div class="path-types">
                    @foreach (var f in Landforms)
                    {
                        var form = f;
                        <button class="path-type @(landform == form.Kind ? "active" : "")" @onclick="() => SetLandform(form.Kind)">
                            <span class="swatch" style="background: @form.Color"></span>@L.T(form.De, form.En)
                        </button>
                    }
                </div>
                <BrushSize Value="@size" ValueChanged="SetSize" />
                <button class="small @(map?.RoundCorners == false ? "active" : "")" @onclick="ToggleCorners">@(map?.RoundCorners == false ? L.T("Eckige Ecken", "Angular corners") : L.T("Runde Ecken", "Round corners"))</button>
                break;

            case Mode.Bridges:
                @if (selectedBridge is { } bridge)
                {
                    var info = IslandMap.BridgeInfo(bridge);
                    <div class="brush-text">
                        <strong>@IslandMap.BridgeStyleName(info.Style)</strong>
                        <span class="hint">@L.T($"{info.Length} Felder lang. Tippe auf einen Stil, um ihn zu ändern.", $"{info.Length} tiles long. Tap a style to change it.")</span>
                    </div>
                }
                else
                {
                    <span class="hint grow">@L.T($"Wähle einen Stil und tippe auf das Wasser eines Flusses. Die Brücke legt sich quer über die schmale Seite, {bridgeCount} von {IslandMap.MaxBridges} Brücken sind gebaut.",
                                                 $"Pick a style and tap the water of a river. The bridge spans the narrow side, {bridgeCount} of {IslandMap.MaxBridges} bridges are built.")</span>
                }
                <div class="path-types">
                    @foreach (var st in IslandMap.BridgeStyles)
                    {
                        var style = st;
                        var active = selectedBridge is { } b ? IslandMap.BridgeInfo(b).Style == style : bridgeStyle == style;
                        <button class="path-type @(active ? "active" : "")" @onclick="() => SetBridgeStyle(style)">@IslandMap.BridgeStyleName(style)</button>
                    }
                </div>
                @if (selectedBridge is not null)
                {
                    <button class="small" @onclick="() => { selectedBridge = null; DrawView(); }">@L.T("Neue Brücke", "New bridge")</button>
                    <button class="small danger" @onclick="RemoveBridge">@L.T("Brücke abreißen", "Remove bridge")</button>
                }
                break;

            case Mode.Buildings:
                @if (selectedBuilding is { } bld)
                {
                    <div class="brush-text">
                        <strong>@IslandMap.BuildingName(bld)</strong>
                        <span class="hint">@(movingBuilding ? L.T("Tippe dorthin, wo die Mitte hin soll.", "Tap where the middle should go.") : L.T($"Mitte bei Feld {bld.X}, {bld.Y}", $"Middle at tile {bld.X}, {bld.Y}"))</span>
                    </div>
                    @if (bld.BuildingType != BuildingType.Bridge)
                    {
                        <div class="stepper">
                            <button @onclick="() => MoveBuilding(-1, 0)" aria-label="@L.T("Nach links", "Left")">&#x25C0;</button>
                            <button @onclick="() => MoveBuilding(0, -1)" aria-label="@L.T("Nach oben", "Up")">&#x25B2;</button>
                            <button @onclick="() => MoveBuilding(0, 1)" aria-label="@L.T("Nach unten", "Down")">&#x25BC;</button>
                            <button @onclick="() => MoveBuilding(1, 0)" aria-label="@L.T("Nach rechts", "Right")">&#x25B6;</button>
                        </div>
                        <button class="small @(movingBuilding ? "active" : "")" @onclick="() => movingBuilding = !movingBuilding">@L.T("Per Tippen versetzen", "Move by tapping")</button>
                    }
                    @if (bld.BuildingType == BuildingType.Incline)
                    {
                        <div class="path-types">
                            @foreach (var st in IslandMap.SlopeStyles)
                            {
                                var style = st;
                                <button class="path-type @((SlopeType)bld.Type == style ? "active" : "")" @onclick="() => SetSlope(style)">@IslandMap.SlopeName(style)</button>
                            }
                        </div>
                        <button class="small" @onclick="FlipIncline">&#x21C5; @L.T("Umdrehen", "Flip")</button>
                    }
                    @if (bld.BuildingType is BuildingType.Bridge or BuildingType.Incline)
                    {
                        <button class="small danger" @onclick="RemoveBuilding">@L.T("Abreißen", "Remove")</button>
                    }
                    <button class="small" @onclick="DeselectBuilding">@L.T("Fertig", "Done")</button>
                }
                else
                {
                    <span class="hint grow">@L.T($"Tippe auf ein Gebäude, eine Brücke oder eine Rampe, um es zu verschieben oder zu ändern. Für eine neue Rampe wähle einen Stil und tippe auf flachen Boden direkt vor einer Klippe, {inclineCount} von {IslandMap.MaxInclines} Rampen sind gebaut.",
                                                 $"Tap a building, bridge or incline to move or change it. For a new incline pick a style and tap flat ground right in front of a cliff, {inclineCount} of {IslandMap.MaxInclines} inclines are built.")</span>
                    <div class="path-types">
                        <button class="path-type @(newIncline is null ? "active" : "")" @onclick="() => newIncline = null">@L.T("Nur auswählen", "Select only")</button>
                        @foreach (var st in IslandMap.SlopeStyles)
                        {
                            var style = st;
                            <button class="path-type @(newIncline == style ? "active" : "")" @onclick="() => newIncline = style">@IslandMap.SlopeName(style)</button>
                        }
                    </div>
                }
                break;

            case Mode.Look when selected is { } sel:
                var tile = map!.Layer(layerIndex).GetTile(sel.RelX, sel.RelY);
                @if (tile.IsNone)
                {
                    <span class="plus">+</span>
                    <div class="brush-text">
                        <strong>@L.T("Leeres Feld", "Empty tile")</strong>
                        <span class="hint">@Position(sel)</span>
                    </div>
                    <button class="small" @onclick="() => picking = Picking.Replace">@L.T("Gegenstand hinlegen", "Put an item")</button>
                    <button class="small" @onclick="() => picking = Picking.ReplaceNature">@L.T("Natur setzen", "Place nature")</button>
                }
                else
                {
                    var same = SameCount(tile);
                    <ItemImage Src="@Picture(tile)" Alt="@FieldItems.Name(tile)" />
                    <div class="brush-text">
                        <strong>@FieldItems.Name(tile)</strong>
                        <span class="hint">@Position(sel)@(same > 1 ? L.T($", {same} gleiche auf der Insel", $", {same} alike on the island") : "")</span>
                    </div>
                    @if (StackOf(tile) > 1)
                    {
                        <div class="stepper">
                            <button @onclick="() => SetAmount(tile.Count)" disabled="@(tile.Count == 0)">&#x2212;</button>
                            <span>@(tile.Count + 1)</span>
                            <button @onclick="() => SetAmount(tile.Count + 2)" disabled="@(tile.Count + 1 >= StackOf(tile))">+</button>
                            <button class="small" @onclick="() => SetAmount(StackOf(tile))">Max</button>
                        </div>
                    }
                    <button class="small" @onclick="() => picking = tile.IsFieldItem ? Picking.ReplaceNature : Picking.Replace">@L.T("Ersetzen", "Replace")</button>
                    @if (same > 1)
                    {
                        <button class="small" @onclick="() => picking = tile.IsFieldItem ? Picking.ReplaceAllNature : Picking.ReplaceAll">@L.T($"Alle {same} ersetzen", $"Replace all {same}")</button>
                        <button class="small danger" @onclick="RemoveAllSame">@L.T($"Alle {same} entfernen", $"Remove all {same}")</button>
                    }
                    <button class="small danger" @onclick="RemoveSelected">@L.T("Entfernen", "Remove")</button>
                }
                break;

            default:
                <span class="hint">@L.T("Tippe auf ein Feld, um zu sehen, was dort liegt.", "Tap a tile to see what lies there.")</span>
                break;
        }
    </div>

    <div class="map-layout">
        <div class="map-overview">
            <canvas @ref="overview"></canvas>
            <p class="hint">@L.T("Tippe auf die Übersicht, um dorthin zu springen.", "Tap the overview to jump there.")</p>
            <button class="small" @onclick="ExportMap">&#x2B07; @L.T("Karte als Bild speichern", "Save the map as a picture")</button>
        </div>
        <div class="map-detail">
            <canvas @ref="detail"></canvas>
            <div class="map-nav">
                <button class="small" @onclick="() => Move(-1, 0)" aria-label="@L.T("Nach links", "Left")">&#x25C0;</button>
                <button class="small" @onclick="() => Move(0, -1)" aria-label="@L.T("Nach oben", "Up")">&#x25B2;</button>
                <button class="small" @onclick="() => Move(0, 1)" aria-label="@L.T("Nach unten", "Down")">&#x25BC;</button>
                <button class="small" @onclick="() => Move(1, 0)" aria-label="@L.T("Nach rechts", "Right")">&#x25B6;</button>
            </div>
        </div>
    </div>

    @if (message is not null)
    {
        <p class="hint center">@message</p>
    }
    @if (mode == Mode.Look && map is not null && selected is { } ds && Ground.GetTile(ds.RelX, ds.RelY) is { IsNone: false } dt)
    {
        <ItemDetails Value="dt" ValueChanged="SetDetails" />
    }
    @if (mode == Mode.Buildings)
    {
        <details class="raw-values">
            <summary>@L.T("Rohwerte wie in NHSE", "Raw values like NHSE")</summary>
            @if (selectedBuilding is { } rb)
            {
                <div class="raw-grid">
                    <label>
                        <span>@L.T("Art", "Kind")</span>
                        <select @onchange="e => SetRaw(rb, RawField.Kind, e.Value)">
                            @foreach (var kind in Enum.GetValues<BuildingType>())
                            {
                                <option value="@((int)kind)" selected="@(kind == rb.BuildingType)">@kind</option>
                            }
                        </select>
                    </label>
                    <label><span>X</span><input type="number" value="@rb.X" @onchange="e => SetRaw(rb, RawField.X, e.Value)" /></label>
                    <label><span>Y</span><input type="number" value="@rb.Y" @onchange="e => SetRaw(rb, RawField.Y, e.Value)" /></label>
                    <label><span>@L.T("Winkel", "Angle")</span><input type="number" min="0" max="3" value="@rb.Angle" @onchange="e => SetRaw(rb, RawField.Angle, e.Value)" /></label>
                    <label><span>Bit</span><input type="number" value="@rb.Bit" @onchange="e => SetRaw(rb, RawField.Bit, e.Value)" /></label>
                    <label><span>@L.T("Typ", "Type")</span><input type="number" value="@rb.Type" @onchange="e => SetRaw(rb, RawField.Type, e.Value)" /></label>
                    <label><span>TypeArg</span><input type="number" value="@rb.TypeArg" @onchange="e => SetRaw(rb, RawField.TypeArg, e.Value)" /></label>
                    <label><span>UniqueID</span><input type="number" value="@rb.UniqueID" @onchange="e => SetRaw(rb, RawField.UniqueId, e.Value)" /></label>
                </div>
            }
            else
            {
                <div class="raw-grid">
                    <label><span>@L.T("Platz X (oben links)", "Plaza X (top left)")</span><input type="number" value="@Main.EventPlazaLeftUpX" @onchange="e => SetPlaza(e.Value, true)" /></label>
                    <label><span>@L.T("Platz Z (oben links)", "Plaza Z (top left)")</span><input type="number" value="@Main.EventPlazaLeftUpZ" @onchange="e => SetPlaza(e.Value, false)" /></label>
                </div>
            }
            <p class="hint">@L.T("Diese Werte schreibt die Seite ohne jede Prüfung in den Spielstand, genau wie NHSE. Die Rampenrichtung ist nicht im Spiel geprüft: zeigt eine Rampe falsch herum, tippe auf Umdrehen.",
                                 "These values go into the save without any check, just like NHSE. The direction of inclines is not checked in the game: if one points the wrong way, tap Flip.")</p>
        </details>
    }
    @if (map is not null)
    {
        <MapFiles Map="map" ViewX="viewX" ViewY="viewY" LayerIndex="layerIndex" Before="BeforeImport" After="AfterImport" Reload="ReloadMap" />
    }
    <p class="hint">@L.T("Stell nichts ins Wasser, auf Klippen oder in Gebäude, das mag das Spiel nicht. Wege, Klippen und Flüsse suchen sich ihre Ränder selbst. Strand, Küste und Wasserfälle bleiben, wie sie sind.",
                         "Do not put anything into water, on cliffs or into buildings, the game does not like that. Paths, cliffs and rivers pick their edges by themselves. Beach, coast and waterfalls stay as they are.")</p>
</section>

@if (bulkDrop && area is { } room)
{
    <BulkDropDialog Player="Player" Brush="brush" Room="@DropRoom(room)" Drop="DropMany" Closed="() => bulkDrop = false" />
}

@if (picking is Picking.Brush or Picking.Replace or Picking.ReplaceAll)
{
    <ItemPickerDialog Title="@(picking switch { Picking.Brush => L.T("Was möchtest du setzen?", "What do you want to place?"), Picking.ReplaceAll => L.T("Womit sollen alle gleichen ersetzt werden?", "What should replace all alike?"), _ => L.T("Was soll hier liegen?", "What should lie here?") })"
                      Current="@(picking != Picking.Brush && selected is { } s ? map!.Layer(layerIndex).GetTile(s.RelX, s.RelY) : brush)"
                      Picked="Picked" Closed="() => picking = Picking.None" />
}
else if (picking is Picking.NatureBrush or Picking.ReplaceNature or Picking.ReplaceAllNature)
{
    <NaturePickerDialog Picked="PickedNature" Closed="() => picking = Picking.None" />
}

@code {
    private enum Mode { Look, Place, Erase, Area, Paths, Terrain, Bridges, Buildings }

    private sealed record LandformTool(IslandMap.Landform Kind, string De, string En, string Color);

    private static readonly LandformTool[] Landforms =
    [
        new(IslandMap.Landform.Raise, "Klippe bauen", "Build cliff", "#8fbf5a"),
        new(IslandMap.Landform.Lower, "Klippe abtragen", "Remove cliff", "#c49a6c"),
        new(IslandMap.Landform.Water, "Fluss graben", "Dig river", "#4fa3d1"),
        new(IslandMap.Landform.Land, "Fluss zuschütten", "Fill river", "#d9c38c"),
    ];
    private enum RawField { Kind, X, Y, Angle, Bit, Type, TypeArg, UniqueId }

    [Parameter] public Player? Player { get; set; }

    private bool bulkDrop;
    private enum Picking { None, Brush, NatureBrush, Replace, ReplaceNature, ReplaceAll, ReplaceAllNature }
    private readonly record struct Spot(int RelX, int RelY);
    private readonly record struct Area(int X, int Y, int W, int H);

    private const int UndoDepth = 30;
    private const string Remove = "#d0613a";

    private IslandMap? map;
    private ElementReference overview;
    private ElementReference detail;
    private IJSObjectReference? module;
    private DotNetObjectReference<MapPanel>? self;

    private Mode mode = Mode.Look;
    private Picking picking;
    private int layerIndex;
    private int viewX;
    private int viewY;
    private int across = 32;
    private int size = 1; // brush size in terrain tiles: 1, 3 or 5
    private Item? brush;
    private string pathType = "Stone";
    private bool pathEraser;
    private Spot? selected;
    private Area? area;
    private string? message;
    private readonly LinkedList<IslandMap.State> undo = new();
    private IslandMap.State? strokeStart;
    private bool strokeChanged;
    private (int X0, int Y0, int X1, int Y1)? dirtyTerrain;
    private string bridgeStyle = "Log";
    private Building? selectedBridge;
    private Building? selectedBuilding;
    private bool movingBuilding;
    private SlopeType? newIncline;
    private IslandMap.Landform landform = IslandMap.Landform.Raise;
    // the level a stroke builds to, taken from the tile it starts on, so dragging makes an even plateau
    private int? terrainLevel;

    private int inclineCount => map!.Buildings.Count(b => b.BuildingType == BuildingType.Incline);

    private int bridgeCount => map!.Buildings.Count(b => b.BuildingType == BuildingType.Bridge);

    private MainSave Main => Session.Save!.Main;
    private LayerFieldItem Ground => map!.Layer(layerIndex);

    protected override void OnInitialized()
    {
        map = new IslandMap(Main);
        // start on the acre in the middle of the island
        viewX = (map.Width / 2) - 16;
        viewY = (map.Height / 2) - 16;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        await Catalog.EnsureLoadedAsync();
        module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/mapview.js");
        self = DotNetObjectReference.Create(this);
        await module.InvokeVoidAsync("initMap", overview, detail, self, map!.Width, map.Height, map.TerrainPixels());
        across = await module.InvokeAsync<int>("tilesAcross", detail);
        ClampView();
        await DrawItems();
        await DrawView();
    }

    // ---- drawing ----

    private Task DrawItems()
    {
        var buildings = map!.Buildings.Where(b => b.BuildingType != 0).Select(b =>
        {
            var (x, y, w, h) = IslandMap.Footprint(b);
            var color = b.BuildingType switch
            {
                _ when ReferenceEquals(b, selectedBridge) || ReferenceEquals(b, selectedBuilding) => "rgba(47, 169, 161, 0.9)",
                BuildingType.Bridge => "rgba(160, 110, 60, 0.9)",
                BuildingType.Incline => "rgba(196, 154, 108, 0.9)",
                _ => "rgba(242, 193, 78, 0.85)",
            };
            return new object[] { x, y, w, h, color };
        });
        return module?.InvokeVoidAsync("setItems", map.ItemPixels(layerIndex), buildings).AsTask() ?? Task.CompletedTask;
    }

    private Task DrawView()
    {
        if (module is null)
            return Task.CompletedTask;
        var layer = Ground;
        var tiles = new List<object[]>();
        // roots up to 8 tiles above or left of the view can still reach into it
        for (int y = viewY - 8; y < viewY + across; y++)
        {
            for (int x = viewX - 8; x < viewX + across; x++)
            {
                if (!map!.TryGetRelative(x, y, out var relX, out var relY))
                    continue;
                var tile = layer.GetTile(relX, relY);
                if (tile.IsNone || !tile.IsRoot)
                    continue;
                var (w, h) = IslandMap.Footprint(tile);
                if (x + w <= viewX || y + h <= viewY)
                    continue;
                tiles.Add([x, y, w, h, Picture(tile)]);
            }
        }

        int[]? selection = null;
        if (mode == Mode.Area && area is { } a)
        {
            selection = [a.X, a.Y, a.W, a.H];
        }
        else if (mode == Mode.Buildings && selectedBuilding is { } sb)
        {
            var (bx, by, bw, bh) = IslandMap.Footprint(sb);
            selection = [bx, by, bw, bh];
        }
        else if (mode == Mode.Bridges && selectedBridge is { } b)
        {
            var (bx, by, bw, bh) = IslandMap.Footprint(b);
            selection = [bx, by, bw, bh];
        }
        else if (mode == Mode.Look && selected is { } s)
        {
            var tile = layer.GetTile(s.RelX, s.RelY);
            var (w, h) = tile.IsNone ? (1, 1) : IslandMap.Footprint(tile);
            var (x, y) = map!.GetAbsolute(s.RelX, s.RelY);
            selection = [x, y, w, h];
        }

        var tool = mode switch { Mode.Look or Mode.Bridges or Mode.Buildings => "look", Mode.Area => "area", _ => "paint" };
        return module.InvokeVoidAsync("setView", viewX, viewY, across, tiles, selection, Cursor(), tool).AsTask();
    }

    // what follows the mouse: [width, height, snap to even tiles, picture, colour, tiles to step back]
    private object[]? Cursor()
    {
        var side = size * 2;
        var back = (size / 2) * 2;
        switch (mode)
        {
            case Mode.Place when brush is not null:
                if (brush.IsFieldItem && size > 1)
                    return [side, side, true, Picture(brush), "#4fae6b", back];
                var (w, h) = IslandMap.Footprint(brush);
                return [w, h, brush.IsFieldItem, Picture(brush), "#4fae6b", 0];
            case Mode.Erase:
                return size == 1 ? [1, 1, false, null!, Remove, 0] : [side, side, true, null!, Remove, back];
            case Mode.Paths:
                return [side, side, true, null!, pathEraser ? Remove : RoadShapes.TypeColor(pathType), back];
            case Mode.Terrain:
                return [side, side, true, null!, Landforms.First(f => f.Kind == landform).Color, back];
            default:
                return null;
        }
    }

    private async Task DrawTerrain(int relX0, int relY0, int relX1, int relY1)
    {
        if (module is null)
            return;
        var (x, y, w, h, pixels) = map!.TerrainPatch(relX0, relY0, relX1, relY1);
        await module.InvokeVoidAsync("patchTerrain", x, y, w, h, pixels);
    }

    // ---- view ----

    private void ClampView()
    {
        viewX = Math.Clamp(viewX, 0, map!.Width - across);
        viewY = Math.Clamp(viewY, 0, map.Height - across);
    }

    [JSInvokable]
    public async Task OnOverviewClick(int x, int y)
    {
        viewX = x - (across / 2);
        viewY = y - (across / 2);
        ClampView();
        await DrawView();
    }

    // keeps the middle of the view in place
    private async Task Zoom(int tiles)
    {
        viewX += (across - tiles) / 2;
        viewY += (across - tiles) / 2;
        across = tiles;
        ClampView();
        await DrawView();
    }

    private async Task Move(int dx, int dy)
    {
        viewX += dx * across / 2;
        viewY += dy * across / 2;
        ClampView();
        await DrawView();
    }

    // ---- taps and strokes ----

    [JSInvokable]
    public async Task OnDetailClick(int x, int y)
    {
        message = null;
        switch (mode)
        {
            case Mode.Look:
                if (map!.TryGetRelative(x, y, out var relX, out var relY))
                    selected = RootOf(Ground, relX, relY);
                else
                    message = L.T("Dort ist Meer oder Strandrand, da kann nichts liegen.", "That is sea or the edge of the beach, nothing can lie there.");
                break;
            case Mode.Place when brush is null:
                message = L.T("Wähle oben zuerst einen Gegenstand oder etwas aus der Natur.", "First choose an item or some nature above.");
                break;
            case Mode.Bridges:
                await TapBridge(x, y);
                break;
            case Mode.Buildings:
                await TapBuilding(x, y);
                break;
            default:
                var before = map!.Snapshot();
                terrainLevel = null;
                if (PaintAt(x, y, single: true))
                {
                    Push(before);
                    await Changed();
                }
                await FlushTerrain();
                break;
        }
        await DrawView();
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnPaint(int x, int y, bool first)
    {
        if (first)
        {
            message = null;
            strokeStart = map!.Snapshot();
            strokeChanged = false;
            terrainLevel = null;
        }
        if (strokeStart is null)
            return;
        strokeChanged |= PaintAt(x, y, single: false);
        await FlushTerrain();
        await DrawView();
    }

    [JSInvokable]
    public async Task OnPaintEnd()
    {
        if (strokeStart is not null && strokeChanged)
        {
            Push(strokeStart);
            await Changed();
        }
        strokeStart = null;
        await DrawView();
        StateHasChanged();
    }

    // One dab of the current tool at an absolute tile. Single taps explain why nothing happened.
    private bool PaintAt(int x, int y, bool single)
    {
        switch (mode)
        {
            case Mode.Erase:
                var (ex, ey, eside) = size == 1 ? (x, y, 1) : Square(x, y);
                return EraseArea(ex, ey, eside, eside, _ => true) > 0;
            case Mode.Place when brush is not null:
                if (brush.IsFieldItem && size > 1)
                {
                    var (px, py, side) = Square(x, y);
                    return FillGrid(px, py, side, side, brush) > 0;
                }
                if (!map!.TryGetRelative(x, y, out var relX, out var relY))
                {
                    if (single)
                        message = L.T("Dort ist Meer oder Strandrand, da kann nichts liegen.", "That is sea or the edge of the beach, nothing can lie there.");
                    return false;
                }
                return Place(Ground, new Item(brush.RawValue), relX, relY, single);
            case Mode.Terrain:
                var (gx, gy, gside) = Square(x, y);
                var why = ShapeLand(x, y, gx, gy, gside);
                if (why is not null && single)
                    message = why;
                return why is null;
            case Mode.Paths:
                var (tx, ty, tside) = Square(x, y);
                var count = LayPath(tx, ty, tside, tside, pathEraser ? null : pathType);
                if (count == 0 && single && !pathEraser)
                    message = L.T("Wege gehen nur auf flachen Boden, nicht auf Strand, Wasser oder Klippen.", "Paths only go on flat ground, not on beach, water or cliffs.");
                return count > 0;
            default:
                return false;
        }
    }

    // square of the brush size around a tile, on the grid of terrain tiles (2 x 2 item tiles)
    private (int X, int Y, int Side) Square(int x, int y)
    {
        var back = (size / 2) * 2;
        return ((x & ~1) - back, (y & ~1) - back, size * 2);
    }

    [JSInvokable]
    public async Task OnArea(int x0, int y0, int x1, int y1)
    {
        message = null;
        area = new Area(Math.Min(x0, x1), Math.Min(y0, y1), Math.Abs(x1 - x0) + 1, Math.Abs(y1 - y0) + 1);
        await DrawView();
        StateHasChanged();
    }

    // ---- editing ----

    // an extension tile of a big item points back to the tile the item starts on
    private static Spot RootOf(LayerFieldItem layer, int relX, int relY)
    {
        var tile = layer.GetTile(relX, relY);
        if (!tile.IsExtension)
            return new Spot(relX, relY);
        var x = relX - tile.ExtensionX;
        var y = relY - tile.ExtensionY;
        layer.TileInfo.ClampInside(ref x, ref y);
        var root = layer.GetTile(x, y);
        return root.IsRoot && root.ItemId == tile.ExtensionItemId ? new Spot(x, y) : new Spot(relX, relY);
    }

    private static void Delete(LayerFieldItem layer, Spot spot)
    {
        var tile = layer.GetTile(spot.RelX, spot.RelY);
        if (tile.IsRoot)
            layer.DeleteExtensionTiles(tile, spot.RelX, spot.RelY);
        tile.Delete();
    }

    // Same checks as NHSE's field item editor: plants snap to even tiles, nothing is overwritten.
    private bool Place(LayerFieldItem layer, Item item, int relX, int relY, bool explain)
    {
        if (item.IsFieldItem)
        {
            relX &= ~1;
            relY &= ~1;
        }
        switch (layer.IsOccupied(item, relX, relY))
        {
            case PlacedItemPermission.OutOfBounds:
                if (explain)
                    message = L.T("Das passt dort nicht mehr auf die Insel.", "That does not fit on the island there.");
                return false;
            case PlacedItemPermission.Collision:
                if (explain)
                    message = L.T("Dort liegt schon etwas. Entferne es zuerst oder such dir freie Felder.",
                        "Something is already there. Remove it first or pick free tiles.");
                return false;
        }
        layer.SetExtensionTiles(item, relX, relY);
        layer.GetTile(relX, relY).CopyFrom(item);
        if (explain)
            selected = new Spot(relX, relY);
        return true;
    }

    /// <summary>Removes everything whose tiles reach into the area and that matches; returns how many.</summary>
    private int EraseArea(int x, int y, int w, int h, Func<Item, bool> match)
    {
        var layer = Ground;
        int count = 0;
        for (int ay = y; ay < y + h; ay++)
        {
            for (int ax = x; ax < x + w; ax++)
            {
                if (!map!.TryGetRelative(ax, ay, out var relX, out var relY))
                    continue;
                var root = RootOf(layer, relX, relY);
                var tile = layer.GetTile(root.RelX, root.RelY);
                if (tile.IsNone || !match(tile))
                    continue;
                Delete(layer, root);
                count++;
            }
        }
        return count;
    }

    /// <summary>Puts the item on every free spot of the area, side by side; returns how many.</summary>
    private int FillGrid(int x, int y, int w, int h, Item item)
    {
        var (fw, fh) = IslandMap.Footprint(item);
        if (item.IsFieldItem)
        {
            // plants sit on whole terrain tiles
            w += x & 1;
            h += y & 1;
            x &= ~1;
            y &= ~1;
            fw = Math.Max(2, fw);
            fh = Math.Max(2, fh);
        }
        int count = 0;
        for (int ay = y; ay + fh <= y + h; ay += fh)
        {
            for (int ax = x; ax + fw <= x + w; ax += fw)
            {
                if (map!.TryGetRelative(ax, ay, out var relX, out var relY) && Place(Ground, new Item(item.RawValue), relX, relY, false))
                    count++;
            }
        }
        return count;
    }

    /// <summary>Lays (or with null removes) a path on the terrain tiles under an item tile area; returns how many changed.</summary>
    private int LayPath(int x, int y, int w, int h, string? type)
    {
        int count = 0;
        int minX = int.MaxValue, minY = int.MaxValue, maxX = int.MinValue, maxY = int.MinValue;
        for (int ay = y & ~1; ay < y + h; ay += 2)
        {
            for (int ax = x & ~1; ax < x + w; ax += 2)
            {
                if (!map!.TryGetTerrain(ax, ay, out var relX, out var relY) || !map.SetPath(relX, relY, type))
                    continue;
                count++;
                minX = Math.Min(minX, relX);
                minY = Math.Min(minY, relY);
                maxX = Math.Max(maxX, relX);
                maxY = Math.Max(maxY, relY);
            }
        }
        if (count == 0)
            return 0;
        map!.ShapePaths(minX, minY, maxX, maxY);
        // the ground picture is redrawn by FlushTerrain, after the edit is complete
        dirtyTerrain = dirtyTerrain is { } d
            ? (Math.Min(d.X0, minX), Math.Min(d.Y0, minY), Math.Max(d.X1, maxX), Math.Max(d.Y1, maxY))
            : (minX, minY, maxX, maxY);
        return count;
    }

    // one dab of the terrain tool on a square of terrain tiles; returns why nothing changed, or null
    private string? ShapeLand(int x, int y, int ax, int ay, int side)
    {
        if (!map!.TryGetTerrain(x, y, out var cx, out var cy))
            return L.T("Dort ist kein Land.", "There is no land there.");
        var e = map.Terrain.GetTile(cx, cy).Elevation;
        terrainLevel ??= landform switch
        {
            IslandMap.Landform.Raise => e + 1,
            IslandMap.Landform.Lower => e - 1,
            _ => e,
        };
        string? reason = null;
        int count = 0;
        int minX = int.MaxValue, minY = int.MaxValue, maxX = int.MinValue, maxY = int.MinValue;
        for (int ty = ay & ~1; ty < ay + side; ty += 2)
        {
            for (int tx = ax & ~1; tx < ax + side; tx += 2)
            {
                if (!map.TryGetTerrain(tx, ty, out var relX, out var relY))
                    continue;
                var r = map.ChangeLand(relX, relY, landform, terrainLevel.Value);
                if (r is not null)
                {
                    if (r.Length > 0)
                        reason ??= r;
                    continue;
                }
                count++;
                minX = Math.Min(minX, relX);
                minY = Math.Min(minY, relY);
                maxX = Math.Max(maxX, relX);
                maxY = Math.Max(maxY, relY);
            }
        }
        if (count == 0)
            return reason ?? L.T("Hier gibt es nichts zu ändern.", "There is nothing to change here.");
        map.ShapeTerrain(minX, minY, maxX, maxY);
        // cliffs and rivers reshape the ring around the change, and paths the ring around that
        dirtyTerrain = dirtyTerrain is { } d
            ? (Math.Min(d.X0, minX - 3), Math.Min(d.Y0, minY - 3), Math.Max(d.X1, maxX + 3), Math.Max(d.Y1, maxY + 3))
            : (minX - 3, minY - 3, maxX + 3, maxY + 3);
        return null;
    }

    private async Task SetLandform(IslandMap.Landform value)
    {
        landform = value;
        await DrawView();
    }

    private void ToggleCorners() => map!.RoundCorners = !map.RoundCorners;

    private async Task FlushTerrain()
    {
        if (dirtyTerrain is not { } d)
            return;
        dirtyTerrain = null;
        await DrawTerrain(d.X0, d.Y0, d.X1, d.Y1);
    }

    private async Task Apply(Func<int> action, Func<int, string> done, string nothing)
    {
        var before = map!.Snapshot();
        var count = action();
        await FlushTerrain();
        if (count == 0)
        {
            message = nothing;
            return;
        }
        Push(before);
        message = done(count);
        await Changed();
        await DrawView();
    }

    private Task ClearArea() => area is { } a
        ? Apply(() => EraseArea(a.X, a.Y, a.W, a.H, _ => true),
            n => L.T(n == 1 ? "1 Sache entfernt." : $"{n} Sachen entfernt.", n == 1 ? "Removed 1 thing." : $"Removed {n} things."), L.T("Im Bereich liegt nichts.", "Nothing lies in the area."))
        : Task.CompletedTask;

    private Task WeedArea() => area is { } a
        ? Apply(() => EraseArea(a.X, a.Y, a.W, a.H, IsWeed),
            n => L.T($"{n} mal Unkraut entfernt.", $"Removed {n} weeds."), L.T("Im Bereich wächst kein Unkraut.", "No weeds grow in the area."))
        : Task.CompletedTask;

    // dropped items lie one per terrain tile, on the even item tiles like NHSE's bulk spawn
    private IEnumerable<(int RelX, int RelY)> DropSpots(Area a)
    {
        for (int ay = (a.Y + 1) & ~1; ay < a.Y + a.H; ay += 2)
        {
            for (int ax = (a.X + 1) & ~1; ax < a.X + a.W; ax += 2)
            {
                if (map!.TryGetRelative(ax, ay, out var relX, out var relY) && Ground.GetTile(relX, relY).IsNone
                    && map.TryGetTerrain(ax, ay, out var tx, out var ty) && map.Terrain.GetTile(tx, ty).UnitModel is var m
                    && !m.IsRiver && !m.IsFall && map.BuildingAt(ax, ay) is null)
                    yield return (relX, relY);
            }
        }
    }

    private int DropRoom(Area a) => DropSpots(a).Count();

    private async Task DropMany(IReadOnlyList<Item> items)
    {
        bulkDrop = false;
        if (area is not { } a)
            return;
        var before = map!.Snapshot();
        int count = 0;
        using var next = items.GetEnumerator();
        foreach (var (relX, relY) in DropSpots(a).ToList())
        {
            if (!next.MoveNext())
                break;
            var item = new Item(next.Current.RawValue) { IsDropped = true };
            if (Ground.IsOccupied(item, relX, relY) != PlacedItemPermission.NoCollision)
                continue;
            Ground.GetTile(relX, relY).CopyFrom(item);
            count++;
        }
        if (count == 0)
        {
            message = L.T("Im Bereich ist kein freier Platz.", "There is no free room in the area.");
            return;
        }
        Push(before);
        message = count < items.Count
            ? L.T($"{count} von {items.Count} hingelegt, für den Rest war kein Platz mehr.", $"Dropped {count} of {items.Count}, the rest did not fit.")
            : L.T($"{count} Gegenstände hingelegt.", $"Dropped {count} items.");
        await Changed();
        await DrawView();
    }

    private Task FillArea() => area is { } a && brush is not null
        ? Apply(() => FillGrid(a.X, a.Y, a.W, a.H, brush),
            n => L.T($"{n} mal gesetzt.", $"Placed {n} times."), L.T("Im Bereich ist kein freier Platz dafür.", "There is no free room for it in the area."))
        : Task.CompletedTask;

    private Task PathArea(string? type) => area is { } a
        ? Apply(() => LayPath(a.X, a.Y, a.W, a.H, type),
            n => type is null ? L.T($"Weg von {Tiles(n)} entfernt.", $"Removed the path from {n} tiles.") : L.T($"Weg auf {Tiles(n)} gelegt.", $"Laid a path on {n} tiles."),
            type is null ? L.T("Im Bereich liegt kein Weg.", "There is no path in the area.") : L.T("Wege gehen nur auf flachen Boden, nicht auf Strand, Wasser oder Klippen.", "Paths only go on flat ground, not on beach, water or cliffs."))
        : Task.CompletedTask;

    private static string Tiles(int n) => n == 1 ? "1 Feld" : $"{n} Feldern";

    private static bool IsWeed(Item tile) => FieldItemList.Items.TryGetValue(tile.ItemId, out var def) && def.Kind.IsWeed;

    private async Task Picked(Item item)
    {
        var target = picking;
        picking = Picking.None;
        if (target == Picking.Brush)
            await SetBrush(item);
        else if (target == Picking.ReplaceAll)
            await ReplaceAllSame(item);
        else
            await ReplaceSelected(item);
    }

    private async Task PickedNature(ushort id)
    {
        var target = picking;
        picking = Picking.None;
        if (target == Picking.NatureBrush)
            await SetBrush(new Item(id));
        else if (target == Picking.ReplaceAllNature)
            await ReplaceAllSame(new Item(id));
        else
            await ReplaceSelected(new Item(id));
    }

    private async Task SetBrush(Item item)
    {
        message = null;
        brush = item;
        mode = Mode.Place;
        await DrawView();
    }

    // replace: take the old item away first, put it back if the new one does not fit
    private async Task ReplaceSelected(Item item)
    {
        message = null;
        if (selected is not { } spot)
            return;
        var before = map!.Snapshot();
        Delete(Ground, spot);
        if (Place(Ground, item, spot.RelX, spot.RelY, true))
        {
            Push(before);
            await Changed();
        }
        else
        {
            map.Restore(before);
        }
        await DrawView();
    }

    private static int StackOf(Item item) =>
        !item.IsFieldItem && ItemInfo.TryGetMaxStackCount(item, out var max) ? max : 1;

    // stackable items keep the amount minus one in Count
    private async Task SetAmount(int amount)
    {
        if (selected is not { } spot)
            return;
        var tile = Ground.GetTile(spot.RelX, spot.RelY);
        Push(map!.Snapshot());
        tile.Count = (ushort)(Math.Clamp(amount, 1, StackOf(tile)) - 1);
        await Changed();
        await DrawView();
    }

    // "alike" as NHSE's replace means it: the very same item, variant and amount included
    private int SameCount(Item tile) => Ground.Tiles.Count(t => t.IsRoot && t.Equals(tile));

    private async Task ReplaceAllSame(Item item)
    {
        message = null;
        if (selected is not { } spot)
            return;
        var layer = Ground;
        var old = new Item(layer.GetTile(spot.RelX, spot.RelY).RawValue);
        var before = map!.Snapshot();
        var count = layer.ReplaceAll(old, item, 0, 0, layer.TileInfo.TotalWidth, layer.TileInfo.TotalHeight);
        if (count < 0)
        {
            message = L.T("Das geht nur mit etwas gleich Großem, sonst würde es mit den Nachbarn überlappen.", "That only works with something of the same size, it would overlap its neighbours otherwise.");
            return;
        }
        Push(before);
        message = L.T($"{count} mal ersetzt.", $"Replaced {count} times.");
        await Changed();
        await DrawView();
    }

    private async Task RemoveAllSame()
    {
        if (selected is not { } spot)
            return;
        var layer = Ground;
        var old = new Item(layer.GetTile(spot.RelX, spot.RelY).RawValue);
        var before = map!.Snapshot();
        var count = EraseArea(0, 0, map.Width, map.Height, t => t.Equals(old));
        Push(before);
        message = L.T($"{count} mal entfernt.", $"Removed {count} times.");
        await Changed();
        await DrawView();
    }

    // ---- bridges ----

    private async Task TapBridge(int x, int y)
    {
        if (map!.BuildingAt(x, y) is { } building)
        {
            selectedBridge = building.BuildingType == BuildingType.Bridge ? building : null;
            if (selectedBridge is null)
                message = L.T("Das ist ein Gebäude. Hier lassen sich nur Brücken ändern.", "That is a building. Only bridges can be changed here.");
            await DrawItems();
            return;
        }
        selectedBridge = null;
        var error = map.PlanBridge(x, y, bridgeStyle, out var plan);
        if (error is not null)
        {
            message = error;
            await DrawItems();
            return;
        }
        var before = map.Snapshot();
        if (!map.AddBuilding(plan))
        {
            message = L.T("Auf der Insel ist kein Platz mehr für ein weiteres Bauwerk.", "The island has no room left for another structure.");
            return;
        }
        Push(before);
        selectedBridge = map.Buildings.First(b => b.X == plan.X && b.Y == plan.Y && b.BuildingType == BuildingType.Bridge);
        message = L.T($"{IslandMap.BridgeStyleName(bridgeStyle)} gebaut, {IslandMap.BridgeInfo(plan).Length} Felder lang.", $"Built a {IslandMap.BridgeStyleName(bridgeStyle)}, {IslandMap.BridgeInfo(plan).Length} tiles long.");
        await Changed();
    }

    private async Task SetBridgeStyle(string style)
    {
        message = null;
        if (selectedBridge is not { } bridge)
        {
            bridgeStyle = style;
            return;
        }
        var (_, length, diagonal) = IslandMap.BridgeInfo(bridge);
        var name = $"Bridge{style}{(diagonal ? "Diagonal" : "")}{(diagonal ? ((BridgeType)bridge.Type).ToString()[^3..] : length.ToString("00"))}";
        if (!Enum.TryParse<BridgeType>(name, out var type))
        {
            message = L.T("Diesen Stil gibt es nicht in dieser Form.", "This style does not exist in this shape.");
            return;
        }
        Push(map!.Snapshot());
        bridge.Type = (ushort)type;
        bridgeStyle = style;
        await Changed();
    }

    private async Task RemoveBridge()
    {
        if (selectedBridge is not { } bridge)
            return;
        Push(map!.Snapshot());
        bridge.Clear();
        selectedBridge = null;
        message = L.T("Brücke abgerissen.", "Bridge removed.");
        await Changed();
    }

    // ---- buildings and inclines ----

    private async Task TapBuilding(int x, int y)
    {
        if (movingBuilding && selectedBuilding is { } moving)
        {
            // keep the middle on the same half tile, so the building stays on the terrain grid
            await PlaceBuilding(moving, x - ((x - moving.X) & 1), y - ((y - moving.Y) & 1));
            return;
        }
        if (map!.BuildingAt(x, y) is { } found)
        {
            selectedBuilding = found;
            await DrawItems();
            return;
        }
        selectedBuilding = null;
        if (newIncline is not { } style)
        {
            await DrawItems();
            return;
        }
        var error = map.PlanIncline(x, y, style, out var plan);
        if (error is not null)
        {
            message = error;
            await DrawItems();
            return;
        }
        var before = map.Snapshot();
        if (!map.AddBuilding(plan))
        {
            message = L.T("Auf der Insel ist kein Platz mehr für ein weiteres Bauwerk.", "The island has no room left for another structure.");
            return;
        }
        Push(before);
        selectedBuilding = map.Buildings.First(b => b.X == plan.X && b.Y == plan.Y && b.BuildingType == BuildingType.Incline);
        message = L.T($"{IslandMap.SlopeName(style)} gesetzt. Prüf im Spiel, ob sie richtig herum steht.", $"Placed a {IslandMap.SlopeName(style)}. Check in the game that it points the right way.");
        await Changed();
    }

    private async Task PlaceBuilding(Building building, int x, int y)
    {
        message = map!.CheckMove(building, x, y);
        if (message is not null)
            return;
        Push(map.Snapshot());
        building.X = (ushort)x;
        building.Y = (ushort)y;
        movingBuilding = false;
        await Changed();
        await DrawView();
    }

    // one terrain tile per step
    private Task MoveBuilding(int dx, int dy) =>
        selectedBuilding is { } b ? PlaceBuilding(b, b.X + (dx * 2), b.Y + (dy * 2)) : Task.CompletedTask;

    private async Task SetSlope(SlopeType style)
    {
        if (selectedBuilding is not { } b)
            return;
        Push(map!.Snapshot());
        b.Type = (ushort)style;
        await Changed();
    }

    private async Task FlipIncline()
    {
        if (selectedBuilding is not { } b)
            return;
        Push(map!.Snapshot());
        b.Angle = (byte)(b.Angle ^ 2);
        message = L.T("Umgedreht.", "Flipped.");
        await Changed();
    }

    private async Task RemoveBuilding()
    {
        if (selectedBuilding is not { } b)
            return;
        Push(map!.Snapshot());
        b.Clear();
        selectedBuilding = null;
        message = L.T("Abgerissen.", "Removed.");
        await Changed();
        await DrawView();
    }

    private async Task DeselectBuilding()
    {
        selectedBuilding = null;
        movingBuilding = false;
        await DrawItems();
        await DrawView();
    }

    private async Task SetRaw(Building b, RawField field, object? value)
    {
        if (!long.TryParse(value?.ToString(), out var v))
            return;
        Push(map!.Snapshot());
        switch (field)
        {
            case RawField.Kind: b.BuildingType = (BuildingType)v; break;
            case RawField.X: b.X = (ushort)Math.Clamp(v, 0, ushort.MaxValue); break;
            case RawField.Y: b.Y = (ushort)Math.Clamp(v, 0, ushort.MaxValue); break;
            case RawField.Angle: b.Angle = (byte)Math.Clamp(v, 0, 3); break;
            case RawField.Bit: b.Bit = (sbyte)Math.Clamp(v, sbyte.MinValue, sbyte.MaxValue); break;
            case RawField.Type: b.Type = (ushort)Math.Clamp(v, 0, ushort.MaxValue); break;
            case RawField.TypeArg: b.TypeArg = (byte)Math.Clamp(v, 0, byte.MaxValue); break;
            case RawField.UniqueId: b.UniqueID = (ushort)Math.Clamp(v, 0, ushort.MaxValue); break;
        }
        if (b.BuildingType == 0)
            selectedBuilding = null;
        await Changed();
        await DrawView();
    }

    private void SetPlaza(object? value, bool x)
    {
        if (!uint.TryParse(value?.ToString(), out var v))
            return;
        if (x)
            Main.EventPlazaLeftUpX = v;
        else
            Main.EventPlazaLeftUpZ = v;
        Session.MarkDirty();
    }

    // genes, wrapping and raw values of the selected item, straight on the map
    private async Task SetDetails(Item item)
    {
        if (selected is not { } spot)
            return;
        Push(map!.Snapshot());
        Ground.GetTile(spot.RelX, spot.RelY).CopyFrom(item);
        await Changed();
        await DrawView();
    }

    private async Task RemoveSelected()
    {
        if (selected is not { } spot)
            return;
        Push(map!.Snapshot());
        Delete(Ground, spot);
        await Changed();
        await DrawView();
    }

    private async Task Rotate()
    {
        if (brush is null)
            return;
        brush.Rotation = (brush.Rotation + 1) & 3;
        await DrawView();
    }

    private async Task SetMode(Mode value)
    {
        mode = value;
        message = null;
        selectedBridge = null;
        selectedBuilding = null;
        movingBuilding = false;
        await DrawItems();
        await DrawView();
    }

    private async Task SetSize(int value)
    {
        size = value;
        await DrawView();
    }

    private async Task SetPathType(string? type)
    {
        pathEraser = type is null;
        if (type is not null)
            pathType = type;
        await DrawView();
    }

    private async Task SetLayer(int index)
    {
        layerIndex = index;
        selected = null;
        await DrawItems();
        await DrawView();
    }

    private void BeforeImport() => Push(map!.Snapshot());

    private async Task AfterImport()
    {
        selected = null;
        selectedBridge = null;
        selectedBuilding = null;
        await Changed();
        if (module is not null)
            await module.InvokeVoidAsync("patchTerrain", 0, 0, map!.Width, map.Height, map.TerrainPixels());
        await DrawView();
    }

    // item flags and the island shape live in main.dat itself: read the whole map again
    private async Task ReloadMap()
    {
        map = new IslandMap(Main);
        undo.Clear();
        await AfterImport();
    }

    private void Push(IslandMap.State state)
    {
        undo.AddFirst(state);
        if (undo.Count > UndoDepth)
            undo.RemoveLast();
    }

    private async Task Undo()
    {
        if (undo.First is not { } last)
            return;
        undo.RemoveFirst();
        map!.Restore(last.Value);
        message = null;
        selectedBridge = null;
        selectedBuilding = null;
        movingBuilding = false;
        await Changed();
        if (module is not null)
            await module.InvokeVoidAsync("patchTerrain", 0, 0, map.Width, map.Height, map.TerrainPixels());
        await DrawView();
    }

    private async Task Changed()
    {
        map!.WriteTo(Main);
        Session.MarkDirty();
        await DrawItems();
    }

    private string Picture(Item item) => FieldItems.Picture(item, Catalog);

    private async Task ExportMap()
    {
        if (module is not null)
            await module.InvokeVoidAsync("exportMap", $"Karte-{StringUtil.CleanFileName(Session.TownName)}.png");
    }

    private string Position(Spot spot)
    {
        var (x, y) = map!.GetAbsolute(spot.RelX, spot.RelY);
        var acre = $"{(char)('A' + (y / 32) - 1)}{x / 32}";
        var text = L.T($"Feld {spot.RelX}, {spot.RelY} im Bereich {acre}", $"Tile {spot.RelX}, {spot.RelY} in acre {acre}");
        if (map.TryGetTerrain(x, y, out var tx, out var ty) && RoadShapes.TypeOf(map.Terrain.GetTile(tx, ty)) is { } road)
            text += L.T($", auf {RoadShapes.TypeName(road)}", $", on {RoadShapes.TypeName(road)}");
        return text;
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (module is not null)
            {
                await module.InvokeVoidAsync("disposeMap");
                await module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
        self?.Dispose();
    }
}
