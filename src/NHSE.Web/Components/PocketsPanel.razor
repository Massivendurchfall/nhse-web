@inject SaveSession Session
@inject ItemCatalog Catalog

<section class="card">
    <header class="card-head">
        <h3>@L.T("Taschen", "Pockets")</h3>
        <span class="pill">@L.T($"{used} von {unlocked} Feldern belegt", $"{used} of {unlocked} slots used")</span>
    </header>
    <p class="hint">@L.T("Tippe auf ein Feld und wähle den Gegenstand per Bild aus.", "Tap a slot and pick the item by its picture.")</p>

    <div class="pocket-grid">
        @for (int i = 0; i < slots.Count; i++)
        {
            var index = i;
            <ItemSlot Item="@slots[index]" Number="@(index + 1)" Locked="@(!Usable(index))" OnClick="() => editing = index" />
        }
    </div>
    <div class="buttons">
        <span class="hint">@L.T("Plätze in den Taschen:", "Pocket slots:")</span>
        <div class="segmented">
            @foreach (var total in new[] { 20, 30, 40 })
            {
                var t = total;
                <button class="@(unlocked == t && Player.Personal.PocketCount == 20 ? "active" : "")" @onclick="() => SetSlots(20, (uint)(t - 20))">@t</button>
            }
        </div>
    </div>
    <details class="raw-values">
        <summary>@L.T("Genau einstellen wie in NHSE", "Set exactly like NHSE")</summary>
        <div class="raw-grid">
            <label>
                <span>@L.T("Taschen (Felder 1 bis 20)", "Pockets (slots 1 to 20)")</span>
                <input type="number" min="0" max="20" value="@Player.Personal.PocketCount" @onchange="e => SetRaw(e.Value, true)" />
            </label>
            <label>
                <span>@L.T("Erweiterung (Felder 21 bis 40)", "Upgrade (slots 21 to 40)")</span>
                <input type="number" min="0" max="20" value="@Player.Personal.BagCount" @onchange="e => SetRaw(e.Value, false)" />
            </label>
        </div>
    </details>
    <p class="hint">@L.T("Im Spiel gibt es 20 Plätze und mit den beiden Erweiterungen 30 und 40. Gegenstände in Feldern, die du wegnimmst, bleiben im Spielstand, sind aber erst wieder da, wenn die Felder zurück sind.",
                         "The game has 20 slots and 30 and 40 with the two upgrades. Items in slots you take away stay in the save, but only show up again once the slots are back.")</p>
</section>

@if (editing >= 0)
{
    <ItemPickerDialog Title="@L.T($"Feld {editing + 1}", $"Slot {editing + 1}")"
                      Current="@slots[editing]" CanClear="@(!slots[editing].IsNone)"
                      Picked="Put" Cleared="Clear" Closed="() => editing = -1" />
}

@code {
    [Parameter, EditorRequired] public Player Player { get; set; } = null!;

    private List<Item> slots = [];
    private int unlocked;
    private int editing = -1;
    private Player? loadedFor;

    private int used => slots.Where((s, i) => Usable(i) && !s.IsNone).Count();

    // the first 20 slots count against PocketCount, the next 20 against BagCount
    private bool Usable(int index) => index < 20 ? index < Player.Personal.PocketCount : index - 20 < Player.Personal.BagCount;

    // Slots 1 to 20 live in Pocket, 21 to 40 in Bag; the counts say how many are usable.
    protected override async Task OnParametersSetAsync()
    {
        if (!ReferenceEquals(loadedFor, Player))
        {
            loadedFor = Player;
            var p = Player.Personal;
            slots = [.. p.Pocket.Select(Copy), .. p.Bag.Select(Copy)];
            unlocked = (int)Math.Min(40, p.PocketCount + p.BagCount);
            editing = -1;
        }
        await Catalog.EnsureLoadedAsync();
    }

    private static Item Copy(Item item) => new()
    {
        ItemId = item.ItemId, SystemParam = item.SystemParam, AdditionalParam = item.AdditionalParam, FreeParam = item.FreeParam,
    };

    private void Store()
    {
        var p = Player.Personal;
        p.Pocket = slots.Take(20).ToArray();
        p.Bag = slots.Skip(20).Take(20).ToArray();
        Session.MarkDirty();
    }

    // 20 slots live in Pocket, the upgrades add 10 and then 20 more in Bag
    private void SetSlots(uint pocket, uint bag)
    {
        var p = Player.Personal;
        p.PocketCount = Math.Min(pocket, 20);
        p.BagCount = Math.Min(bag, 20);
        unlocked = (int)Math.Min(slots.Count, p.PocketCount + p.BagCount);
        Session.MarkDirty();
    }

    private void SetRaw(object? value, bool pocket)
    {
        if (!uint.TryParse(value?.ToString(), out var v))
            return;
        var p = Player.Personal;
        if (pocket)
            SetSlots(v, p.BagCount);
        else
            SetSlots(p.PocketCount, v);
    }

    private void Put(Item item)
    {
        slots[editing] = item;
        editing = -1;
        Store();
    }

    private void Clear()
    {
        slots[editing] = new Item { ItemId = Item.NONE };
        editing = -1;
        Store();
    }
}
